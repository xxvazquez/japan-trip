# Copy to .env.local and fill in. All optional — with nothing set the app runs
# fully local (data stays in the browser, no sign-in).

# Supabase (cloud sync + multi-device + trip sharing).
# Create a project at supabase.com, run every file in supabase/migrations/ in
# order, enable the Google auth provider, then paste these from
# Project Settings -> API. VITE_SUPABASE_URL must be the full https URL.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Map background. Unset = Protomaps' full planet file (works, but 20-30s to first
# paint). Point this at a small self-hosted regional .pmtiles extract for an
# instant map — see "The map background" in the README.
VITE_MAP_TILES_URL=
