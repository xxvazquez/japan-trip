# Copy to .env.local and fill in. All optional — with nothing set the app runs
# fully local (data stays in the browser, no sign-in).

# Supabase (cloud sync + multi-device + trip sharing).
# Create a project at supabase.com, run every file in supabase/migrations/ in
# order, enable the Google auth provider, then paste these from
# Project Settings -> API. VITE_SUPABASE_URL must be the full https URL.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Drive (shared storage for Logbook document attachments).
# Reuses the same Google Cloud project as Supabase sign-in:
#  1. APIs & Services -> enable "Google Drive API"
#  2. OAuth client (Web) -> Authorised JavaScript origins: your dev + prod URLs
#  3. Google Auth Platform -> Data access -> add scope .../auth/drive.file
# Paste the Web client id (…apps.googleusercontent.com). Not secret. Unset =
# attachments stay on-device only.
VITE_GOOGLE_CLIENT_ID=

# Map background — pick ONE (or neither).
#
# Recommended: a Protomaps hosted API key. Whole planet, CDN-cached, fast
# anywhere on Earth, and free for non-commercial use (<=1M tiles/month). Get a
# key at https://protomaps.com/account — paste just the key, not a URL.
VITE_PROTOMAPS_API_KEY=
#
# Or: a self-hosted .pmtiles file (a regional extract built with `pmtiles
# extract`). Only covers the box you extracted. Ignored if the key above is set.
# Unset both = Protomaps' full planet file (works everywhere, ~20-30s first paint).
# See "The map background" in the README.
VITE_MAP_TILES_URL=

# Real walking routes (actual streets, not a straight line) for an area's
# width on the Map and a plan step's walk to the next one.
# Free key (no card) at openrouteservice.org/dev/#/signup — 2,000 requests/day.
VITE_ORS_API_KEY=

# Real transit-ride times (actual scheduled lines and transfers, not a
# straight-line guess) for the "Train: ... total" figure on a long walk
# between plan steps. Free key (no card) at developer.here.com —
# 250,000 requests/month.
VITE_HERE_API_KEY=
