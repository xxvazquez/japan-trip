# Copy to .env.local and fill in. Both are optional — the app degrades gracefully.

# Google Maps Embed API key. Free + unlimited for the Embed API.
# Restrict it by HTTP referrer to your deployed domain in the Google Cloud console.
VITE_GMAPS_EMBED_KEY=

# A Google "My Map" id (the mid= value from its share/embed link).
# The map must be shared as "anyone with the link".
VITE_MYMAP_MID=
