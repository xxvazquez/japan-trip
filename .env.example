# Copy to .env.local and fill in what you need. Everything is optional —
# with nothing set the app runs fully local (data stays in the browser).

# ── Supabase (cloud sync + multi-device) ────────────────────────────
# Create a project at supabase.com, run supabase/migrations/0001_init.sql,
# enable the Google auth provider, then paste these from Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google Maps (optional) ─────────────────────────────────────────
# Maps Embed API key — free, unlimited. Restrict it by HTTP referrer.
VITE_GMAPS_EMBED_KEY=
# A shared Google "My Map" id (the mid= value from its embed link).
VITE_MYMAP_MID=
